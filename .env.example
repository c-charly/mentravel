# MEN TRAVEL - variables d'environnement (toutes optionnelles)

# Port d'ecoute du serveur Node (Dokploy route le trafic vers ce port)
PORT=3000
HOST=0.0.0.0

# URL publique du site (SEO, QR code, liens signes)
NUXT_PUBLIC_SITE_URL=https://booking-mentravel.cm

# Numero WhatsApp de l'agence, format international sans le +
NUXT_PUBLIC_WHATSAPP_NUMBER=237653677443

# Dossier de persistance des reservations, colis et devis (monter un volume dessus)
NUXT_DATA_DIR=/data

# Paiement simule: autorise ?sim=success|fail|timeout. Mettre false pour couper les cas de test
NUXT_ALLOW_SIM=true

# Retenue des sieges (minutes), maximum de sieges par reservation, jours de calendrier
NUXT_HOLD_MINUTES=10
NUXT_MAX_SEATS=5
NUXT_CALENDAR_DAYS=60

# Delai de la simulation de paiement (secondes)
NUXT_PAYMENT_DELAY_SEC=4

# Deverrouillage du billet par numero d'identification: echecs permis puis blocage (minutes)
NUXT_UNLOCK_MAX_FAILS=5
NUXT_UNLOCK_LOCK_MINUTES=15

# Liens hreflang et canoniques: meme valeur que l'URL publique (a definir aussi comme build arg Docker)
NUXT_PUBLIC_I18N_BASE_URL=https://booking-mentravel.cm
